# Application
APP_ENV=development
APP_NAME=Gym Face Access
APP_TIMEZONE=Asia/Jakarta
SECRET_KEY=development-only-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ports exposed by Docker Compose
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL (Docker is the primary setup)
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
# Disable auto-create outside development; production uses reviewed migrations.
DATABASE_URL=postgresql+psycopg://gym:gym@postgres:5432/gym
AUTO_CREATE_DB=true

# For local development without Docker, override DATABASE_URL with:
# DATABASE_URL=sqlite:///./gym.db

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=false
VITE_FACE_ENGINE=opencv_sface
VITE_DEVICE_TOKEN=development-device-secret

# Recognition defaults are for development only and require field calibration.
FACE_ENGINE=opencv_sface
FACE_MODEL_NAME=opencv_sface
FACE_MODEL_VERSION=2021dec
FACE_DETECTION_MODEL_PATH=runtime-models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL_PATH=runtime-models/face_recognition_sface_2021dec.onnx
FACE_DETECTION_MODEL_SHA256=8F2383E4DD3CFBB4553EA8718107FC0423210DC964F9F4280604804ED2552FA4
FACE_RECOGNITION_MODEL_SHA256=0BA9FBFA01B5270C96627C4EF784DA859931E02F04419C829E83484087C34E79
FACE_MATCH_METRIC=cosine
FACE_MATCH_THRESHOLD=0.50
FACE_MATCH_AMBIGUITY_MARGIN=0.05
FACE_ENROLLMENT_CONSISTENCY_THRESHOLD=0.45
FACE_MIN_QUALITY_SCORE=0.70
LIVENESS_MODE=none
LIVENESS_MIN_SCORE=0.70
DEPTH_VALIDATION_ENABLED=false
DEPTH_MIN_SCORE=0.70

# Device and access control
DEVICE_AUTH_MODE=shared_secret
DEVICE_SHARED_SECRET=development-device-secret
CHECKIN_COOLDOWN_SECONDS=60
KIOSK_RESULT_COOLDOWN_SECONDS=3
MAX_SAMPLE_BYTES=5000000
LOGIN_RATE_LIMIT=10
KIOSK_RATE_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=60

# Raw biometric captures are disabled by default.
RAW_CAPTURE_STORAGE_ENABLED=false
RAW_CAPTURE_RETENTION_HOURS=24

# Development seed only. Production must use a unique password or disable seed.
DEMO_PASSWORD=GymDemo123!

# API container behavior. Seeding is always a separate command.
MIGRATE_ON_START=true
